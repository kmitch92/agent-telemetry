  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Sessions",
      "description": "One row per Session, newest first. Start and last event come from observed_timestamp on every Event, in milliseconds. Model calls count kind=model_call Events, tool calls count kind=tool_call Events, and input tokens sum input_tokens on kind=model_call. Open means the Session has an Event in the last 30 minutes. Cost is absent on purpose: see Known gaps in README.md.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "min_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | unwrap observed_timestamp [$__range]) by (session_id, agent, project, run_id) / 1000000",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "max_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | unwrap observed_timestamp [$__range]) by (session_id) / 1000000",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (session_id) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"model_call\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (session_id) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"tool_call\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (session_id) (sum_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"model_call\" | unwrap input_tokens [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (session_id) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} [30m]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "include",
                "names": [
                  "start",
                  "last event"
                ]
              }
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "open"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "closed",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 0,
                      "to": 100000000000,
                      "result": {
                        "text": "open",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "includeByName": {},
            "indexByName": {
              "session_id": 0,
              "agent": 1,
              "project": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #F": 5,
              "Value #C": 6,
              "Value #D": 7,
              "Value #E": 8,
              "run_id": 9
            },
            "renameByName": {
              "Value #A": "start",
              "Value #B": "last event",
              "Value #C": "model calls",
              "Value #D": "tool calls",
              "Value #E": "input tokens",
              "Value #F": "open"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "last event",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sessions started over time, by agent",
      "description": "Counts the distinct Sessions with at least one Event in each interval, grouped by agent. Reads every Kind: model_call, tool_call, prompt and run_end all count. LogQL cannot bucket a Session by its first Event, so this panel shows Session activity, not first appearance.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count by (agent) (sum by (session_id, agent) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} [$__interval])))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
