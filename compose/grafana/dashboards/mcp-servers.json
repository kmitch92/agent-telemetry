          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Raw bytes against returned bytes, totals and ratio",
      "description": "Sums mcp_server.raw_bytes and mcp_server.returned_bytes on kind=mcp_server_call Events over the selected range, and divides the returned total by the raw total. The ratio reads NaN when every mcp_server_call Event reports zero raw bytes, which happens when the server made no upstream request.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_raw_bytes != \"\" | unwrap mcp_server_raw_bytes [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "raw bytes"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_returned_bytes != \"\" | unwrap mcp_server_returned_bytes [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "returned bytes"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_returned_bytes != \"\" | unwrap mcp_server_returned_bytes [$__range])) / sum(sum_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_raw_bytes != \"\" | unwrap mcp_server_raw_bytes [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "returned over raw"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Errors by error type",
      "description": "Reads mcp_server.error.type on kind=mcp_server_call Events whose status attribute is error, counted over the selected range, one bar per error type.",
      "datasource": {
