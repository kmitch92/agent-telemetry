          },
          "editorMode": "code",
          "expr": "sum by (mcp_server_error_type) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_status=\"error\" [$__range]))",
          "queryType": "instant",
