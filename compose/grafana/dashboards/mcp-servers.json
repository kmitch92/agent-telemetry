  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "mcp_server_call rate, per server",
      "description": "Shows the per-second rate of kind=mcp_server_call Events, one line per service_name.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (rate({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" [$__interval]))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Total, internal and upstream milliseconds, p50 and p95, per server",
      "description": "Reads total_ms, internal_ms and upstream_ms on kind=mcp_server_call Events, the 50th and 95th percentile per server. mcp_server.total_ms is a MUST attribute, so every server appears in the total series, while mcp_server.internal_ms and mcp_server.upstream_ms are SHOULD attributes, so a server that omits them is absent from those series.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.5, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | unwrap mcp_server_total_ms [$__interval]) by (service_name)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p50 total {{service_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | unwrap mcp_server_total_ms [$__interval]) by (service_name)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p95 total {{service_name}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.5, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_internal_ms != \"\" | unwrap mcp_server_internal_ms [$__interval]) by (service_name)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p50 internal {{service_name}}"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_internal_ms != \"\" | unwrap mcp_server_internal_ms [$__interval]) by (service_name)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p95 internal {{service_name}}"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.5, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_upstream_ms != \"\" | unwrap mcp_server_upstream_ms [$__interval]) by (service_name)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p50 upstream {{service_name}}"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_upstream_ms != \"\" | unwrap mcp_server_upstream_ms [$__interval]) by (service_name)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p95 upstream {{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "spanNulls": false
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Cache hit ratio per server",
      "description": "Divides the kind=mcp_server_call Events whose cache attribute is hit by all kind=mcp_server_call Events that report a cache state, one bar per service_name. The denominator counts only an Event that reports a cache state, because mcp_server.cache is a SHOULD attribute.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_cache=\"hit\" [$__range])) / sum by (service_name) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_cache!=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Target distribution, top 10",
      "description": "Shows the top 10 targets by call count over the selected range, counting kind=mcp_server_call Events grouped by the mcp_server.target attribute.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (mcp_server_target) (count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\"} | kind=\"mcp_server_call\" | mcp_server_target != \"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{mcp_server_target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
