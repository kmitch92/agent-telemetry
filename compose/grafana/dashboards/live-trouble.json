    {
      "id": 12,
      "type": "stat",
      "title": "Quietest active Session, time silent",
      "description": "Reads observed_timestamp on every Event over the selected time range, the latest value per session_id, so only a Session that emitted at least one Event in the window counts as active. The built-in Grafana variable $__to (the end of the selected time range, in Unix milliseconds) minus each Session's latest observed_timestamp (converted from nanoseconds to milliseconds) gives that Session's silence so far; the outer max picks the longest, catching a Session that has stalled. noValue reads 0 when no Session is active in the window at all.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "max($__to - (max by (session_id) (max_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | unwrap observed_timestamp [$__range])) / 1000000))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120000
              },
              {
                "color": "red",
                "value": 300000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
