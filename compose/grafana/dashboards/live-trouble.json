    {
      "id": 9,
      "type": "state-timeline",
      "title": "Trouble windows",
      "description": "One row, counting kind=tool_call failures plus kind=mcp_server_call errors in each interval over the selected time range. Each `or (... * 0)` term reports a true zero for an interval that saw any Event at all but no failure of that kind, so a colored segment means genuine trouble, a zero segment means a quiet-but-active interval, and a gap means no Event at all; no Event is fabricated to fill a gap.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "(sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | kind=\"tool_call\" | success=\"false\" [$__interval])) or (sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} [$__interval])) * 0)) + (sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | kind=\"mcp_server_call\" | mcp_server_status=\"error\" [$__interval])) or (sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} [$__interval])) * 0))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
