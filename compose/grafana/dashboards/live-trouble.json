  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failed tool calls in window",
      "description": "Counts kind=tool_call Events whose success attribute is false, over the selected time range (default the last 24 hours). The noValue field reads 0 instead of \"No data\" when Loki returns no matching line, so a clean window reads as a genuine zero.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | kind=\"tool_call\" | success=\"false\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Tool call success rate",
      "description": "Divides the kind=tool_call Events whose success attribute is true by all kind=tool_call Events over the selected time range, as a percentage, red below 95 percent.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "100 * sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | kind=\"tool_call\" | success=\"true\" [$__range])) / sum(count_over_time({service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | kind=\"tool_call\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "success rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Slowest model call in window",
      "description": "Reads duration_ms on kind=model_call Events, the maximum value anywhere in the selected time range, coloured by thresholds at 10s and 30s. noValue reads 0 when no model call landed in the window.",
