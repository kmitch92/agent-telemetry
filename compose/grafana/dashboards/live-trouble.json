    {
      "id": 7,
      "type": "timeseries",
      "title": "Model call duration, p95, over the window",
      "description": "Reads duration_ms on kind=model_call Events, the 95th percentile duration in each interval, one series per model, over the selected time range, so an API that is slowing down shows as a rising line. The by (model) grouping is required, not cosmetic: without it quantile_over_time groups by every distinct stream instead of collapsing to one series per model, and over a 24-hour range with many historical streams that exceeded Loki's 500-series-per-query limit. Model calls are sparse relative to $__interval in a short live window, so null buckets are bridged and every point is drawn.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\".+\", agent=~\"$agent\", project=~\"$project\", session_id=~\"$session_id\", run_id=~\"$run_id\", task=~\"$task\", variant=~\"$variant\", session_label=~\"$session_label\", branch=~\"$branch\"} | kind=\"model_call\" | unwrap duration_ms [$__interval]) by (model)",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "p95 {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
